<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0-windows</TargetFramework>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>p3ppc.P3RShuffleTime</RootNamespace>
    <AssemblyName>p3ppc.P3RShuffleTime</AssemblyName>
    <OutputPath>$(RELOADEDIIMODS)/p3ppc.P3RShuffleTime</OutputPath>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="ModConfig.json" CopyToOutputDirectory="Always" />
    <Content Include="skill_cards.json" CopyToOutputDirectory="Always" />
    <Content Include="FEmulator\**\*.msg" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="FEmulator\PAK\**\*.bmd" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Reloaded.Mod.Interfaces" Version="2.4.0" ExcludeAssets="runtime" />
    <PackageReference Include="Reloaded.Memory.SigScan.ReloadedII.Interfaces" Version="1.2.0" />
    <PackageReference Include="Reloaded.SharedLib.Hooks" Version="1.9.0" />
  </ItemGroup>
</Project>
